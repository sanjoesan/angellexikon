---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaveDivider from '../components/WaveDivider.astro';
---
<BaseLayout title="Angel-Quiz" description="Teste dein Angelwissen im großen Angel-Quiz – mit Schwierigkeitsstufen und über 500 Fragen zu Fischen, Techniken, Ködern, Knoten und Regeln.">
  <section class="cat-hero">
    <div class="container">
      <span class="big-emoji" aria-hidden="true">❓</span>
      <h1>Angel-Quiz</h1>
      <p class="lead">Wie gut kennst du dich aus? Wähle eine Schwierigkeitsstufe – pro Runde gibt es 12 zufällige Fragen.</p>
    </div>
  </section>
  <WaveDivider />

  <section class="section container narrow">
    <div class="quizcard" style="max-width:720px;margin-inline:auto">
      <div id="quiz-start">
        <h2 style="font-family:var(--font-display);margin-bottom:.3rem">Wähle deine Schwierigkeit</h2>
        <p class="muted">12 zufällige Fragen pro Runde – die Antwortmöglichkeiten werden jedes Mal neu gemischt.</p>
        <div class="quiz-difficulties">
          <button class="diffbtn" data-diff="leicht" type="button" disabled>🟢 Leicht<small data-cnt="leicht">…</small></button>
          <button class="diffbtn" data-diff="mittel" type="button" disabled>🟡 Mittel<small data-cnt="mittel">…</small></button>
          <button class="diffbtn" data-diff="schwer" type="button" disabled>🔴 Schwer<small data-cnt="schwer">…</small></button>
          <button class="diffbtn" data-diff="all" type="button" disabled>🎲 Gemischt<small data-cnt="all">…</small></button>
        </div>
        <p id="quiz-loading" class="muted" style="margin-top:1rem">Lade Fragen …</p>
      </div>

      <div id="quiz-game" hidden>
        <div class="quiz-top"><span id="quiz-progress"></span><span id="quiz-score"></span></div>
        <div class="quiz-bar"><span id="quiz-barfill"></span></div>
        <h2 id="quiz-q"></h2>
        <div id="quiz-opts" class="quiz-opts"></div>
        <div id="quiz-explain" class="quiz-explain" hidden></div>
        <div style="margin-top:1.2rem;display:flex;gap:.6rem;flex-wrap:wrap;align-items:center">
          <button class="btn btn-primary" id="quiz-next" type="button" hidden>Weiter ›</button>
          <button class="btn" id="quiz-abort" type="button">Abbrechen</button>
        </div>
      </div>

      <div id="quiz-result" class="quiz-final" hidden></div>
    </div>
  </section>

  <script>
    import { withBase } from '../utils/url';

    const esc = (s: string) => (s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const shuffle = <T,>(a: T[]): T[] => { for (let k = a.length - 1; k > 0; k--) { const j = Math.floor(Math.random() * (k + 1)); [a[k], a[j]] = [a[j], a[k]]; } return a; };

    const startEl = $('quiz-start'), gameEl = $('quiz-game'), resultEl = $('quiz-result'), loadingEl = $('quiz-loading');
    const progEl = $('quiz-progress'), scoreEl = $('quiz-score'), barEl = document.querySelector('#quiz-barfill') as HTMLElement;
    const qEl = $('quiz-q'), optsEl = $('quiz-opts'), explainEl = $('quiz-explain');
    const nextBtn = $('quiz-next') as HTMLButtonElement, abortBtn = $('quiz-abort') as HTMLButtonElement;
    const diffBtns = [...document.querySelectorAll('.diffbtn')] as HTMLButtonElement[];

    const COUNT = 12;
    let ALL: any[] = [];
    let pool: any[] = [], i = 0, score = 0, answered = false, correctIdx = -1;

    fetch(withBase('/quiz-data.json'))
      .then((r) => r.json())
      .then((data) => {
        ALL = Array.isArray(data) ? data : [];
        const c: Record<string, number> = { leicht: 0, mittel: 0, schwer: 0 };
        ALL.forEach((q) => { if (c[q.diff] != null) c[q.diff]++; });
        document.querySelector('[data-cnt="leicht"]')!.textContent = c.leicht + ' Fragen';
        document.querySelector('[data-cnt="mittel"]')!.textContent = c.mittel + ' Fragen';
        document.querySelector('[data-cnt="schwer"]')!.textContent = c.schwer + ' Fragen';
        document.querySelector('[data-cnt="all"]')!.textContent = ALL.length + ' Fragen';
        loadingEl.hidden = true;
        diffBtns.forEach((b) => (b.disabled = false));
      })
      .catch(() => { loadingEl.textContent = 'Die Fragen konnten leider nicht geladen werden.'; });

    diffBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const diff = b.dataset.diff;
        const src = diff === 'all' ? ALL.slice() : ALL.filter((q) => q.diff === diff);
        pool = shuffle(src).slice(0, Math.min(COUNT, src.length));
        if (!pool.length) return;
        i = 0; score = 0;
        startEl.hidden = true; resultEl.hidden = true; gameEl.hidden = false;
        renderQ();
      })
    );

    function renderQ() {
      answered = false;
      const item = pool[i];
      const opts = item.o.map((t: string, idx: number) => ({ t, correct: idx === 0 }));
      shuffle(opts);
      correctIdx = opts.findIndex((o: any) => o.correct);
      progEl.textContent = `Frage ${i + 1} von ${pool.length}`;
      scoreEl.textContent = `${score} Punkte`;
      barEl.style.width = (i / pool.length) * 100 + '%';
      qEl.textContent = item.q;
      explainEl.hidden = true;
      nextBtn.hidden = true;
      optsEl.innerHTML = opts.map((o: any, idx: number) => `<button class="quiz-opt" type="button" data-i="${idx}">${esc(o.t)}</button>`).join('');
      optsEl.querySelectorAll('.quiz-opt').forEach((b) => b.addEventListener('click', () => choose(Number((b as HTMLElement).dataset.i))));
    }

    function choose(idx: number) {
      if (answered) return;
      answered = true;
      const btns = [...optsEl.querySelectorAll('.quiz-opt')] as HTMLButtonElement[];
      btns.forEach((b, k) => { b.disabled = true; if (k === correctIdx) b.classList.add('correct'); else if (k === idx) b.classList.add('wrong'); });
      if (idx === correctIdx) score++;
      scoreEl.textContent = `${score} Punkte`;
      explainEl.innerHTML = (idx === correctIdx ? '✅ Richtig! ' : '❌ Leider falsch. ') + esc(pool[i].e || '');
      explainEl.hidden = false;
      nextBtn.hidden = false;
      nextBtn.textContent = i === pool.length - 1 ? 'Ergebnis anzeigen ›' : 'Weiter ›';
    }

    function finish() {
      gameEl.hidden = true;
      resultEl.hidden = false;
      const pct = score / pool.length;
      let grade = '🪱 Frischling – üben lohnt sich!';
      if (pct >= 0.9) grade = '🏆 Angel-Profi!';
      else if (pct >= 0.7) grade = '🎣 Echter Petrijünger';
      else if (pct >= 0.5) grade = '🐟 Solider Sonntagsangler';
      resultEl.innerHTML = `<div class="qscore">${score}/${pool.length}</div><p style="font-size:1.3rem;font-weight:600;margin:.6rem 0 1.2rem">${grade}</p><button class="btn btn-primary" id="quiz-again" type="button">↺ Neue Runde</button>`;
      ($('quiz-again') as HTMLElement).addEventListener('click', backToStart);
    }

    function backToStart() { gameEl.hidden = true; resultEl.hidden = true; startEl.hidden = false; }

    nextBtn.addEventListener('click', () => { if (i < pool.length - 1) { i++; renderQ(); } else finish(); });
    abortBtn.addEventListener('click', backToStart);
  </script>
</BaseLayout>
