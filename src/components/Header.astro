---
import { NAV, SITE } from '../consts';
import { withBase } from '../utils/url';

const path = Astro.url.pathname.replace(/\/+$/, '');
function isCurrent(key: string): boolean {
  const base = withBase('/' + key).replace(/\/+$/, '');
  return path === base || path.startsWith(base + '/');
}
---
<header class="site-header">
  <div class="container">
    <a class="brand" href={withBase('/')} aria-label={`${SITE.title} – Startseite`}>
      <span class="logo" aria-hidden="true">🎣</span>
      <span>{SITE.title}<span class="brand-sub">Lexikon des Angelns</span></span>
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      <ul>
        {NAV.map((c) => (
          <li>
            <a href={withBase('/' + c.key + '/')} aria-current={isCurrent(c.key) ? 'page' : undefined}>
              <span class="nico" aria-hidden="true">{c.icon}</span>{c.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-tools">
      <button class="search-trigger" data-search-open type="button" aria-label="Suche öffnen">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
        <span class="st-label">Suchen…</span>
        <kbd class="st-key">/</kbd>
      </button>

      <button class="icon-btn theme-toggle" data-theme-toggle type="button" aria-label="Hell-/Dunkelmodus umschalten">
        <svg class="moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
        <svg class="sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>

      <button class="icon-btn burger" data-menu-toggle type="button" aria-label="Menü öffnen" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
      </button>
    </div>
  </div>
</header>

<nav class="mobile-nav" aria-label="Mobile Navigation">
  <ul>
    {NAV.map((c) => (
      <li>
        <a href={withBase('/' + c.key + '/')}>
          <span class="nico" aria-hidden="true">{c.icon}</span>
          <span>{c.label}<br /><small class="muted">{c.singular}</small></span>
        </a>
      </li>
    ))}
    <li>
      <a href={withBase('/saison/')}>
        <span class="nico" aria-hidden="true">📅</span>
        <span>Saison-Kalender<br /><small class="muted">Wann beißt was?</small></span>
      </a>
    </li>
  </ul>
</nav>
