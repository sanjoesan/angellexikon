---
import { CATEGORIES, SITE, REPO_URL } from '../consts';
import { withBase } from '../utils/url';
import WaveDivider from './WaveDivider.astro';
const year = 2026;
const tools = [
  { href: '/saison/', label: '📅 Saison-Kalender' },
  { href: '/karte/', label: '🗺️ Revier-Karte' },
  { href: '/rechner/', label: '🧮 Fang-Rechner' },
  { href: '/fangbuch/', label: '📓 Fangbuch' },
  { href: '/quiz/', label: '❓ Angel-Quiz' },
  { href: '/rekorde/', label: '🏆 Rekorde' },
  { href: '/montagen/', label: '🪝 Montagen' },
  { href: '/merkliste/', label: '⭐ Merkliste' },
  { href: '/sicherheit/', label: '🚑 Sicherheit' },
  { href: '/ueber/', label: 'ℹ️ Über das Projekt' },
];
---
<footer class="site-footer">
  <WaveDivider flip />
  <div class="container">
    <div class="footer-inner">
      <div>
        <a class="brand" href={withBase('/')}>
          <span class="logo" aria-hidden="true">🎣</span>
          <span>{SITE.title}</span>
        </a>
        <p class="f-about">
          Das große, frei zugängliche Lexikon des Angelns – Fische, Techniken, Gewässer und
          Reviere aus aller Welt. Mit Liebe zum Petrijünger gebaut.
        </p>
      </div>

      <div>
        <h4>Lexikon</h4>
        <ul>
          {CATEGORIES.map((c) => (
            <li><a href={withBase('/' + c.key + '/')}>{c.icon} {c.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4>Werkzeuge &amp; mehr</h4>
        <ul>
          {tools.map((t) => (
            <li><a href={withBase(t.href)}>{t.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {SITE.title} · Petri Heil! 🐟</span>
      <span>
        Gebaut mit <a href="https://astro.build" rel="noopener" target="_blank">Astro</a>
        · <a href={REPO_URL} rel="noopener" target="_blank">Quellcode auf GitHub</a>
      </span>
    </div>
  </div>
</footer>
