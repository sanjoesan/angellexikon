---
// Global command-palette style search. Opens on the `open-search` window event
// (dispatched from the header button or the ⌘K / "/" shortcut in BaseLayout).
---
<div class="search-modal" id="search-modal" hidden>
  <div class="search-box" role="dialog" aria-modal="true" aria-label="Lexikon durchsuchen">
    <div class="sb-input">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
      <input type="search" id="sb-q" placeholder="Suche nach Fisch, Technik, Köder, Gewässer…" autocomplete="off" spellcheck="false" aria-label="Suchbegriff" />
      <kbd>Esc</kbd>
    </div>
    <div class="sb-results" id="sb-results" role="listbox" aria-label="Suchergebnisse"></div>
    <div class="sb-foot"><span>↑↓ Navigieren</span><span>⏎ Öffnen</span><span>Esc Schließen</span></div>
  </div>
</div>

<script>
  import Fuse from 'fuse.js';
  import { withBase } from '../utils/url';

  const modal = document.getElementById('search-modal') as HTMLElement;
  const input = document.getElementById('sb-q') as HTMLInputElement;
  const resultsEl = document.getElementById('sb-results') as HTMLElement;

  let fuse: any = null;
  let items: any[] = [];
  let active = -1;
  let loaded = false;

  const esc = (s: string) =>
    (s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

  async function ensureIndex() {
    if (loaded) return;
    loaded = true;
    try {
      const res = await fetch(withBase('/search-index.json'));
      items = await res.json();
      fuse = new Fuse(items, {
        keys: [
          { name: 'name', weight: 0.5 },
          { name: 'tagline', weight: 0.2 },
          { name: 'keywords', weight: 0.2 },
          { name: 'cat', weight: 0.1 },
        ],
        threshold: 0.38,
        ignoreLocation: true,
        minMatchCharLength: 2,
      });
    } catch (e) {
      console.error('Suchindex konnte nicht geladen werden', e);
    }
  }

  function render(list: any[]) {
    if (!list.length) {
      resultsEl.innerHTML = '<div class="sb-empty">Keine Treffer – probiere einen anderen Begriff. 🎣</div>';
      return;
    }
    resultsEl.innerHTML = list
      .map(
        (it) => `
      <a class="sb-result" role="option" href="${it.url}">
        <span class="sb-emoji">${it.icon || '🐟'}</span>
        <span style="flex:1;min-width:0">
          <span class="sb-name">${esc(it.name)}</span>
          <span class="sb-tag"> — ${esc(it.tagline || '')}</span><br>
          <span class="sb-cat">${esc(it.cat)}</span>
        </span>
      </a>`
      )
      .join('');
    active = -1;
  }

  function open() {
    modal.hidden = false;
    document.body.classList.add('menu-open');
    setTimeout(() => input.focus(), 20);
    ensureIndex().then(() => {
      if (!input.value.trim()) render(items.slice(0, 8));
    });
  }
  function close() {
    modal.hidden = true;
    document.body.classList.remove('menu-open');
    active = -1;
  }
  function move(dir: number) {
    const els = [...resultsEl.querySelectorAll('.sb-result')] as HTMLElement[];
    if (!els.length) return;
    active = (active + dir + els.length) % els.length;
    els.forEach((el, i) => el.classList.toggle('active', i === active));
    els[active]?.scrollIntoView({ block: 'nearest' });
  }

  input?.addEventListener('input', () => {
    const q = input.value.trim();
    if (!q) {
      render(items.slice(0, 8));
      return;
    }
    if (!fuse) return;
    render(fuse.search(q, { limit: 12 }).map((r: any) => r.item));
  });

  window.addEventListener('open-search', open);
  window.addEventListener('keydown', (e) => {
    if (modal.hidden) return;
    if (e.key === 'Escape') { e.preventDefault(); close(); }
    else if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
    else if (e.key === 'Enter') {
      const els = [...resultsEl.querySelectorAll('.sb-result')] as HTMLElement[];
      const el = els[active] || els[0];
      if (el) window.location.href = el.getAttribute('href') as string;
    }
  });
  modal?.addEventListener('click', (e) => { if (e.target === modal) close(); });
</script>
